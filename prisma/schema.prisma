generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trainer {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?

  clients   Client[]
  gyms      Gym[]
  exercises Exercise[]
  templates Template[]
}

model Gym {
  id      String   @id @default(uuid())
  name    String
  clients Client[]

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model Exercise {
  id          String  @id @default(uuid())
  name        String
  description String?
  defaultRest Int     @default(60)

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model Template {
  id   String @id @default(uuid())
  name String
  days String

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

model Client {
  id         String        @id @default(uuid())
  name       String
  email      String
  password   String?       @default("password") // <-- Aggiunta password (default "password" per test)
  goal       String
  activePlan String?
  isActive   Boolean       @default(true)
  history    String?
  gymId      String?
  gym        Gym?          @relation(fields: [gymId], references: [id])
  messages   Message[]
  logs       ExerciseLog[] // <-- Relazione con i log

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}

// NUOVO MODELLO PER LO STORICO ALLENAMENTI
model ExerciseLog {
  id         String  @id @default(uuid())
  type       String // 'Serie' o 'Riscaldamento'
  date       String
  time       String
  reps       Int
  weight     Float
  isOld      Boolean @default(false)
  exerciseId String // L'ID dell'esercizio (quello dentro il JSON della scheda)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Message {
  id        String  @id @default(uuid())
  text      String
  sender    String
  timestamp String
  read      Boolean @default(false)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
